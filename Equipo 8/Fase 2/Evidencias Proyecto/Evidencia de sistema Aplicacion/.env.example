# =====================================================================
# Variables de entorno para el docker-compose.yml de la raíz (perfil de
# producción, para probar las imágenes en local)
# =====================================================================
# Copiar a ".env" en este mismo directorio y rellenar con valores reales
# ANTES de levantar los contenedores. Este fichero (.env) nunca debe llegar
# al repositorio — ya está en .gitignore.
#
# Producción real (GCP) NO usa este fichero: las variables de Cloud Run
# están en api.env.yaml (Cloud Shell) y los secretos en Secret Manager.
# Ver docs/DEPLOYMENT.md.
#
# backend/.env y frontend/.env son para desarrollo local SIN Docker; este
# docker-compose.yml no los lee — todo lo que el backend necesita se le
# pasa aquí, en la sección "environment" de cada servicio.
# =====================================================================

# -----------------------------------------------------------------------
# Puertos publicados en local. 8010 en vez de 8000 es herencia del
# despliegue en Azure; no afecta a GCP.
# -----------------------------------------------------------------------
BACKEND_PORT=8010
FRONTEND_PORT=8080

# -----------------------------------------------------------------------
# PostgreSQL y Redis: este perfil no los levanta. Apuntar a instancias
# existentes (en GCP viven en la VM corestream-data, 10.10.0.10, solo
# alcanzable desde Cloud Run o por túnel IAP — ver docs/DEPLOYMENT.md).
# Todas las claves y canales de Redis llevan el prefijo "corestream:"
# (ver app/redis_client.py).
# -----------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://corestream:CAMBIAR-en-.env@host.docker.internal:5432/corestream
REDIS_URL=redis://host.docker.internal:6379/5

# -----------------------------------------------------------------------
# Autenticación (backend)
# -----------------------------------------------------------------------
# Generar con: openssl rand -hex 32 — el arranque ABORTA si esto no cambia
# y ENVIRONMENT=production (ver app/config.py, validate_production_settings).
SECRET_KEY=cambiar-esta-clave-por-una-generada
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------
# Entorno
# -----------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# Corte de respaldo del WebSocket (segundos sin actividad del usuario). El
# frontend ya pregunta "¿Sigues ahí?" a los 10 min y corta a los 15.
WS_IDLE_TIMEOUT_SECONDS=1200

# Almacenamiento de documentos: "gcs" en GCP (obligatorio en producción),
# "local" para desarrollo (guarda bajo UPLOAD_DIR).
STORAGE_BACKEND=gcs
GCS_BUCKET=corestream-file

# ID del proyecto de GCP. Con valor, cada log queda enlazado a la traza de su
# request en Cloud Logging. Vacío = logs sin enlace de traza.
GCP_PROJECT_ID=corestream-project
APP_NAME=CoreStream API

# Dominio real desde el que se sirve el frontend. Sin esquema duplicado ni
# barra final. Con ENVIRONMENT=production, ALLOWED_ORIGINS con "*" aborta
# el arranque (no se puede combinar con allow_credentials=True).
ALLOWED_ORIGINS=https://corestream.alloxentric.com

# IP(s) desde las que se acepta X-Forwarded-For / X-Forwarded-Proto. "*"
# es razonable: en Cloud Run solo se entra por el balanceador (ingress
# internal-and-cloud-load-balancing). La IP real para el rate limit la
# decide XFF_CLIENT_POSITION, no uvicorn.
FORWARDED_ALLOW_IPS=*

# Posición (desde la derecha) de la IP real del cliente en X-Forwarded-For,
# para el rate limit de login. Con FORWARDED_ALLOW_IPS=* uvicorn toma la
# primera entrada, que el cliente puede falsear. 0 = sin proxy delante
# (local); 1 = un solo proxy delante; 2 = balanceador HTTPS externo de GCP
# (valor en producción, verificado). Ver backend/app/middleware/rate_limit.py.
XFF_CLIENT_POSITION=0

# Procesos de uvicorn por contenedor. 1 en Cloud Run (escala por instancias).
UVICORN_WORKERS=1

# Pool de conexiones a Postgres por instancia (máx. = suma de ambos).
# Total = (DB_POOL_SIZE + DB_MAX_OVERFLOW) x max-instances de Cloud Run;
# debe quedar bajo max_connections de Postgres.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# -----------------------------------------------------------------------
# Traducción de documentos: Google Cloud Translation. Sin claves: usa la
# cuenta de servicio de Cloud Run (rol roles/cloudtranslate.user) y factura
# al proyecto de GCP_PROJECT_ID. En local: gcloud auth application-default login.
# Sin credenciales, traducir responde 503 "no configurada" (no rompe nada).
# -----------------------------------------------------------------------
TRANSLATION_LOCATION=global

# -----------------------------------------------------------------------
# Envío de correo (invitaciones — plan 3.7.1). Vacío = feature desactivada
# (el admin sigue pudiendo copiar el link de invitación a mano desde la UI).
# Zoho Mail: smtppro.zoho.eu puerto 465 con SSL (SMTP_USE_SSL=True) o
# puerto 587 con STARTTLS (SMTP_USE_SSL=False).
# -----------------------------------------------------------------------
SMTP_HOST=smtppro.zoho.eu
SMTP_PORT=587
SMTP_USE_SSL=False
SMTP_USER=CAMBIAR-en-.env
SMTP_PASSWORD=CAMBIAR-en-.env
MAIL_FROM=CAMBIAR-en-.env
MAIL_FROM_NAME=CoreStream

# -----------------------------------------------------------------------
# Frontend (solo en tiempo de build; Vite las incrusta en el bundle)
# -----------------------------------------------------------------------
# Vacío = usar '/api' (correcto cuando el mismo Nginx sirve front y proxya
# /api hacia el backend, que es el caso previsto). Solo cambiar si el
# frontend se sirve desde un dominio distinto al del backend.
VITE_API_BASE_URL=
